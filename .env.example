# Model and documents settings are read at run start; the API key is never persisted.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
CWE_ARCHIVE_PATH=.knowledge/cwe-top25-1435.xml.zip
YASA_SOURCE_PATH=tools/yasa-mcp
YASA_BIN_PATH=tools/yasa
YASA_INIT_TIMEOUT=3600
YASA_STATUS_TIMEOUT=120
YASA_MCP_TIMEOUT=60

# Documents
DOCUMENTS_TIMEOUT=1800
DOCUMENTS_MODEL_TIMEOUT=60
DOCUMENTS_FETCH_TIMEOUT=30
DOCUMENTS_CHUNK_CHARS=12000
# Deprecated compatibility value; summary batching is token-based via AGENT_CONTEXT_TOKENS.
DOCUMENTS_CONTEXT_CHARS=60000
DOCUMENTS_SUMMARY_RESERVE=180
# auto: agent reading for small/medium local documents, map reading otherwise
DOCUMENTS_READ_MODE=auto
DOCUMENTS_AGENT_CHUNK_TOKENS=1500
DOCUMENTS_MAX_TEXT_BYTES=2000000
DOCUMENTS_MAX_PDF_BYTES=50000000
DOCUMENTS_MAX_PDF_PAGES=300
DOCUMENTS_MAX_DOCX_BYTES=20000000
DOCUMENTS_MAX_DOCX_BLOCKS=5000

# Security history
SECURITY_HISTORY_TIMEOUT=3600
SECURITY_HISTORY_DISCOVERY_TIMEOUT=600
SECURITY_HISTORY_TASK_TIMEOUT=600
SECURITY_HISTORY_MODEL_TIMEOUT=60
SECURITY_HISTORY_SUMMARY_RESERVE=120
SECURITY_HISTORY_MAX_AGENTS=3
SECURITY_HISTORY_DIFF_CHARS=24000
SECURITY_HISTORY_MAX_MODEL_CALLS=32
SECURITY_HISTORY_DISCOVERY_MAX_MODEL_CALLS=32
SECURITY_HISTORY_SUMMARY_MAX_MODEL_CALLS=16
SECURITY_HISTORY_PATCH_MAX_MODEL_CALLS=24

# Discover
DISCOVER_RECURSION_LIMIT=50
DISCOVER_SCREEN_WAVE_TIMEOUT=1200
DISCOVER_SCREEN_WAVE_MODEL_CALLS=96
DISCOVER_SCREEN_TASK_MAX_ROUNDS=16
DISCOVER_SCREEN_TOOL_OUTPUT_CHARS=12000
DISCOVER_SCREEN_CONTEXT_CHARS=40000
DISCOVER_SCREEN_WAVE_MAX_TASKS=6
DISCOVER_CONTEXT_TOKENS=10000
DISCOVER_REQUEST_TIMEOUT=180
DISCOVER_SEARCH_MAX_FILE_BYTES=2097152
DISCOVER_SEARCH_MAX_SCAN_FILES=2000
DISCOVER_NOTES_MAX=20
DISCOVER_NOTE_CHARS=2000
DISCOVER_PLANNER_MODEL=
DISCOVER_PLANNER_MAX_CALLS=6
DISCOVER_PLANNER_MAX_NEW_TASKS=2
DISCOVER_PLANNER_MAX_FILES=8
DISCOVER_PLANNER_MAX_CHARS=40000
DISCOVER_REVIEW_MODEL=
DISCOVER_REVIEW_MAX_CALLS=8
DISCOVER_REVIEW_TIMEOUT=300
DISCOVER_REVIEW_STAGNATION_WAVES=3
DISCOVER_FEATURE_MAX_RESULTS=200
DISCOVER_FEATURE_MAX_TASKS=32
DISCOVER_FEATURE_QUERY_TIMEOUT=30
DISCOVER_FEATURE_MAX_REGEX_CHARS=512
DISCOVER_CONFIRM_MODEL=
DISCOVER_CONFIRM_TIMEOUT=600
DISCOVER_CONFIRM_MAX_CALLS=32
DISCOVER_CONFIRM_MAX_TASKS=6
DISCOVER_CONFIRM_MAX_CANDIDATES=8
DISCOVER_CONFIRM_MAX_SAME_FILE=4

# Audit graph
AUDIT_MODE=combined
AUDIT_TIMEOUT=3600
AUDIT_RECURSION_LIMIT=50
AUDIT_MAX_AGENTS=4
AUDIT_PLAN_BATCH_SIZE=100
# 0 disables the soft cap. The cap is checked before the next model call.
AUDIT_MAX_TOTAL_TOKENS=0
AUDIT_MAX_TOTAL_COST=0
# Global model-call concurrency for trace/verify/recon.
AUDIT_MODEL_CONCURRENCY=4

# Validate environment builder
VALIDATE_ENV_MODEL=
VALIDATE_ENV_GATE_MODE=balanced
VALIDATE_ENV_MAX_PLAN_CALLS=5
VALIDATE_ENV_MAX_DIAGNOSE_CALLS=3
VALIDATE_ENV_MAX_BUILD_ATTEMPTS=3
VALIDATE_ENV_MAX_PLAN_REVISIONS=3
VALIDATE_ENV_MAX_GATE_REVISIONS=2
VALIDATE_ENV_LLM_TIMEOUT=300
VALIDATE_ENV_AGENT_MAX_ROUNDS=24
VALIDATE_ENV_AGENT_MAX_CALLS=24
VALIDATE_ENV_TOOL_OUTPUT_CHARS=12000
VALIDATE_ENV_CONTEXT_CHARS=50000
VALIDATE_ENV_MAX_CONTEXT_BYTES=1073741824
VALIDATE_ENV_MAX_CONTEXT_FILES=20000
VALIDATE_ENV_RECURSION_LIMIT=50
VALIDATE_ENV_BASE_IMAGE_ALLOWLIST=python,node,golang,rust,openjdk,debian,ubuntu,alpine
VALIDATE_DOCKER_BIN=docker
VALIDATE_DOCKER_HOST=
VALIDATE_DOCKER_PULL=never
VALIDATE_DOCKER_PLATFORM=
VALIDATE_DOCKER_BUILD_TIMEOUT=1800
VALIDATE_DOCKER_SMOKE_TIMEOUT=120
VALIDATE_DOCKER_MEMORY=2g
VALIDATE_DOCKER_CPUS=2.0
VALIDATE_DOCKER_PIDS=256
VALIDATE_DOCKER_LOG_BYTES=10000000
VALIDATE_MODEL=
VALIDATE_LLM_TIMEOUT=300
VALIDATE_AGENT_MAX_ROUNDS=32
VALIDATE_AGENT_MAX_CALLS=64
VALIDATE_TOOL_OUTPUT_CHARS=12000
VALIDATE_COMMAND_TIMEOUT=600
VALIDATE_TOTAL_TIMEOUT=1800
# Soft validate-stage usage caps; 0 disables.
VALIDATE_MAX_TOTAL_TOKENS=0
VALIDATE_MAX_TOTAL_COST=0

# Report: local advisory drafting only; never sends or submits anything.
REPORT_MODEL=
REPORT_LANGUAGE=en
REPORT_LLM_TIMEOUT=300
REPORT_TOTAL_TIMEOUT=900
# Soft report-stage usage caps; 0 disables.
REPORT_MAX_TOTAL_TOKENS=0
REPORT_MAX_TOTAL_COST=0
REPORT_MAX_FINDINGS=10

# Shared agent loop: per-call rounds, per-task caps, token-aware compaction
AGENT_MAX_ROUNDS_PER_CALL=32
AGENT_HARD_TASK_CAP=128
AGENT_TOOL_RESULT_TOKENS=2000
AGENT_KEEP_RECENT_RESULTS=3
AGENT_CONTEXT_TOKENS=40000
AGENT_COMPACTION_TRIGGER=0.8
AGENT_TOKEN_SAFETY=1.2
AGENT_CACHE_BYTES=64000000

# Retries: model attempts, JSON repair calls, tool transport attempts
AGENT_MODEL_RETRIES=3
AGENT_JSON_REPAIR_ATTEMPTS=1
AGENT_TOOL_RETRIES=1

# Read-only tool limits
TOOLS_FS_READ_TIMEOUT=10
TOOLS_FS_SEARCH_TIMEOUT=30
TOOLS_GIT_TIMEOUT=30
TOOLS_HTTP_TIMEOUT=30
TOOLS_HTTP_MAX_BYTES=2000000

# Optional JSON price table: [{"model": "...", "input_per_million": 1.0, "output_per_million": 2.0}]
USAGE_PRICE_TABLE=
